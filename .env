# ==========================================
# CONFIGURAÇÃO DO AMBIENTE LOCAL (DEV) - KIVO
# ==========================================

# PostgreSQL
POSTGRES_DB=kivo_db
POSTGRES_USER=kivo_admin
POSTGRES_PASSWORD=kivo_secret_local
DATABASE_URL=postgresql+asyncpg://kivo_admin:kivo_secret_local@localhost:5432/kivo_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Segurança e JWT
SECRET_KEY=kivo_super_secret_jwt_key_dev_2026
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# API & Frontend
ENVIRONMENT=dev
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
